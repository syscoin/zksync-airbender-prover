+#include "../src/msm_memory_policy.cuh"
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <initializer_list>
+
+using msm::memory_policy::default_chunks;
+
+int main() {
+  static_assert(msm::memory_policy::WRAPPER_SCALARS_LOG == 25);
+  static_assert(msm::memory_policy::WRAPPER_WINDOW_BITS == 17);
+  static_assert(msm::memory_policy::WRAPPER_CHUNK_LOG == 20);
+  constexpr auto device = default_chunks(25, false, 25, 25);
+  constexpr auto pinned = default_chunks(25, false, 20, 24);
+  constexpr auto forced = default_chunks(25, true, 22, 25);
+  static_assert(device.minimum == 20 && device.maximum == 20);
+  static_assert(pinned.minimum == 20 && pinned.maximum == 20);
+  static_assert(forced.minimum == 22 && forced.maximum == 25);
+  for (unsigned domain = 0; domain < 32; ++domain) {
+    if (domain == 25) continue;
+    for (unsigned lower = 0; lower <= domain; ++lower) {
+      const auto unchanged = default_chunks(domain, false, lower, domain);
+      assert(unchanged.minimum == lower && unchanged.maximum == domain);
+    }
+  }
+  const auto smaller_start = default_chunks(25, false, 19, 25);
+  assert(smaller_start.minimum == 19 && smaller_start.maximum == 20);
+  // Mirror the unchanged production input-offset loop: no truncation to chunk size.
+  for (const auto limits : {device, pinned, smaller_start}) {
+    const std::uint64_t count = std::uint64_t{1} << 25;
+    std::uint64_t offset = 0;
+    unsigned loops = 0;
+    unsigned log_inputs_count = limits.minimum;
+    while (offset < count) {
+      const std::uint64_t chunk = std::uint64_t{1} << log_inputs_count;
+      const bool first = offset == 0;
+      assert(chunk <= (std::uint64_t{1} << 20));
+      assert(offset + chunk <= count);
+      offset += chunk;
+      ++loops;
+      if (!first && log_inputs_count < limits.maximum) ++log_inputs_count;
+    }
+    assert(offset == count);
+    assert(loops == (limits.minimum == 20 ? 32 : 33));
+  }
+  // Explicit fixed-array arithmetic. CUDA/CUB scratch is measured separately on Linux.
+  constexpr std::uint64_t windows = (254 - 1) / 17 + 1;
+  constexpr std::uint64_t buckets = windows * (std::uint64_t{1} << 16) * 128;
+  constexpr std::uint64_t pair_indexes = 2 * (windows + 1) * (std::uint64_t{1} << 20) * 4;
+  static_assert(windows == 15 && buckets == 125829120 && pair_indexes == 134217728);
+  std::printf("MSM pure policy PASS; full_count=33554432 chunks=32 bucket_bytes=%llu paired_index_bytes=%llu; CUDA not executed\n",
+              static_cast<unsigned long long>(buckets), static_cast<unsigned long long>(pair_indexes));
+}
