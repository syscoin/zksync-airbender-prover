+#include "ff.cuh"
+#include "ff_dispatch_st.cuh"
+#include "bellman-cuda-cub.cuh"
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+// Standalone CUDA correctness test: independent host fd_q reference, no Googletest.
+// This must be compiled against the candidate library, not an installed original.
+using F = fd_q;
+using S = F::storage;
+static constexpr unsigned CHUNK = 1u << 19;
+
+static void checked(cudaError_t error, const char *expression, int line) {
+  if (error != cudaSuccess) {
+    std::fprintf(stderr, "CUDA error %d at line %d: %s\n", int(error), line, expression);
+    std::exit(1);
+  }
+}
+#define CHECK(expression) checked((expression), #expression, __LINE__)
+
+static void equal(const S &actual, const S &expected, const char *operation, unsigned count, unsigned index) {
+  if (!F::eq(actual, expected)) {
+    std::fprintf(stderr, "%s mismatch count=%u index=%u\n", operation, count, index);
+    std::exit(2);
+  }
+}
+
+static S field(unsigned value) { return F::to_montgomery({value}); }
+
+static std::vector<S> values(unsigned count) {
+  std::vector<S> result(count);
+  unsigned state = 0x57184590u;
+  for (auto &value : result) {
+    state = state * 1664525u + 1013904223u;
+    value = field(state ? state : 1u); // Batch inversion's existing nonzero domain.
+  }
+  return result;
+}
+
+// Independent single CPU batch, not the CUDA per-thread or chunk partition.
+static std::vector<S> inverse_reference(const std::vector<S> &input) {
+  std::vector<S> result(input.size());
+  auto product = F::get_one();
+  for (unsigned i = 0; i < input.size(); ++i) {
+    result[i] = product;
+    product = F::mul(product, input[i]);
+  }
+  auto inverse = F::inverse(product);
+  for (size_t i = input.size(); i-- > 0;) {
+    result[i] = F::mul(result[i], inverse);
+    inverse = F::mul(inverse, input[i]);
+  }
+  return result;
+}
+
+// Horner reference is independent of the candidate's powers/reduce/chunk offset.
+static S polynomial_reference(const std::vector<S> &input, const S &point) {
+  S result{};
+  for (size_t i = input.size(); i-- > 0;)
+    result = F::add(F::mul(result, point), input[i]);
+  return result;
+}
+
+static void inverse_test(cudaMemPool_t pool, cudaStream_t stream, unsigned count, bool alias) {
+  if (count == 0) {
+    CHECK(ff::inverse({pool, stream, nullptr, nullptr, 0}));
+    return;
+  }
+  const auto input = values(count);
+  const auto expected = inverse_reference(input);
+  std::vector<S> guarded(count + 2, field(0xdeadbeefu));
+  for (unsigned i = 0; i < count; ++i)
+    guarded[i + 1] = input[i];
+  S *device_input;
+  S *device_output;
+  CHECK(cudaMalloc(&device_input, guarded.size() * sizeof(S)));
+  CHECK(cudaMalloc(&device_output, guarded.size() * sizeof(S)));
+  CHECK(cudaMemcpyAsync(device_input, guarded.data(), guarded.size() * sizeof(S), cudaMemcpyHostToDevice, stream));
+  CHECK(cudaMemcpyAsync(device_output, guarded.data(), guarded.size() * sizeof(S), cudaMemcpyHostToDevice, stream));
+  auto output = alias ? device_input : device_output;
+  CHECK(ff::inverse({pool, stream, device_input + 1, output + 1, count}));
+  CHECK(cudaStreamSynchronize(stream));
+  std::vector<S> actual(guarded.size());
+  CHECK(cudaMemcpy(actual.data(), output, actual.size() * sizeof(S), cudaMemcpyDeviceToHost));
+  equal(actual.front(), guarded.front(), "inverse guard", count, 0);
+  equal(actual.back(), guarded.back(), "inverse guard", count, count + 1);
+  for (unsigned i = 0; i < count; ++i)
+    equal(actual[i + 1], expected[i], "inverse", count, i);
+  if (!alias) {
+    CHECK(cudaMemcpy(actual.data(), device_input, actual.size() * sizeof(S), cudaMemcpyDeviceToHost));
+    for (unsigned i = 0; i < actual.size(); ++i)
+      equal(actual[i], guarded[i], "inverse input unchanged", count, i);
+  }
+  CHECK(cudaFree(device_output));
+  CHECK(cudaFree(device_input));
