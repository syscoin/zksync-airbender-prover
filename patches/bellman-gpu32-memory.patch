+#pragma once
+
+namespace msm::memory_policy {
+
+// SYSCOIN: This is scheduling geometry, not the field, curve, proof security or wrapper domain.
+// The existing signed-window kernels already support the 17-bit window at other input sizes.
+constexpr unsigned WRAPPER_SCALARS_LOG = 25;
+constexpr unsigned WRAPPER_WINDOW_BITS = 17;
+constexpr unsigned WRAPPER_CHUNK_LOG = 20;
+
+struct chunk_limits {
+  unsigned minimum;
+  unsigned maximum;
+};
+
+constexpr unsigned clamp_chunk(const unsigned value) {
+  return value < WRAPPER_CHUNK_LOG ? value : WRAPPER_CHUNK_LOG;
+}
+
+constexpr chunk_limits default_chunks(const unsigned scalars_log, const bool force_minimum,
+                                      const unsigned minimum, const unsigned maximum) {
+  // Preserve unrelated domains and an explicitly requested backend schedule. force_maximum
+  // takes the existing early-return path before this helper is called.
+  return scalars_log == WRAPPER_SCALARS_LOG && !force_minimum
+             ? chunk_limits{clamp_chunk(minimum), clamp_chunk(maximum)}
+             : chunk_limits{minimum, maximum};
+}
+
+} // namespace msm::memory_policy
