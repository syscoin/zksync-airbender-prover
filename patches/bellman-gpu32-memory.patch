+  CHECK(cudaMemcpy(guarded.data(), device_values, guarded.size() * sizeof(S), cudaMemcpyDeviceToHost));
+  equal(guarded.front(), field(0xdeadbeefu), "polynomial guard", count, 0);
+  equal(guarded.back(), field(0xdeadbeefu), "polynomial guard", count, count + 1);
+  for (unsigned i = 0; i < count; ++i) {
+    const bool overwritten = (alias_mode >= 1 && alias_mode <= 3) || alias_mode == 5;
+    equal(guarded[i + 1], overwritten && i == replaced ? expected : input[i], "polynomial input", count, i);
+  }
+  CHECK(cudaFree(device_result));
+  CHECK(cudaFree(device_point));
+  CHECK(cudaFree(device_values));
+}
+
+static void inverse_zero_rejected(cudaMemPool_t pool, cudaStream_t stream, unsigned count, unsigned zero_index) {
+  auto input = values(count);
+  input[zero_index] = S{};
+  S *device_values;
+  CHECK(cudaMalloc(&device_values, size_t(count) * sizeof(S)));
+  CHECK(cudaMemcpyAsync(device_values, input.data(), size_t(count) * sizeof(S), cudaMemcpyHostToDevice, stream));
+  const auto error = ff::inverse({pool, stream, device_values, device_values, count});
+  if (error != cudaErrorInvalidValue) {
+    std::fprintf(stderr, "zero inverse did not fail closed count=%u index=%u error=%d\n", count, zero_index, int(error));
+    std::exit(4);
+  }
+  std::vector<S> actual(count);
+  CHECK(cudaMemcpy(actual.data(), device_values, size_t(count) * sizeof(S), cudaMemcpyDeviceToHost));
+  for (unsigned i = 0; i < count; ++i)
+    equal(actual[i], input[i], "rejected inverse unchanged", count, i);
+  CHECK(cudaFree(device_values));
+}
+
+static S power_reference(S point, unsigned exponent) {
+  auto result = F::get_one();
+  for (; exponent; exponent >>= 1, point = F::sqr(point))
+    if (exponent & 1u)
+      result = F::mul(result, point);
+  return result;
+}
+
+static S geometric_reference(const S &point, unsigned count) {
+  if (F::eq(point, F::get_one()))
+    return field(count);
+  return F::mul(F::sub(power_reference(point, count), F::get_one()), F::inverse(F::sub(point, F::get_one())));
+}
+
+static void uniform_vector_check(const S *device_values, const S &expected, unsigned count, unsigned replaced, const S &replacement) {
+  std::vector<S> host(CHUNK);
+  for (unsigned offset = 0; offset < count;) {
+    const unsigned length = count - offset < CHUNK ? count - offset : CHUNK;
+    CHECK(cudaMemcpy(host.data(), device_values + offset, length * sizeof(S), cudaMemcpyDeviceToHost));
+    for (unsigned i = 0; i < length; ++i)
+      equal(host[i], offset + i == replaced ? replacement : expected, "full25 vector", count, offset + i);
+    offset += length;
+  }
+}
+
+static void full25_test(cudaMemPool_t pool, cudaStream_t stream) {
+  const unsigned count = 1u << 25;
+  S *device_values;
+  S *device_output;
+  S *device_point;
+  CHECK(cudaMalloc(&device_values, size_t(count) * sizeof(S)));
+  CHECK(cudaMalloc(&device_output, sizeof(S)));
+  CHECK(cudaMalloc(&device_point, sizeof(S)));
+  const S value = field(0x571u);
+  CHECK(ff::set_value_by_val(device_values, &value, count, stream));
+  CHECK(ff::inverse({pool, stream, device_values, device_values, count}));
+  CHECK(cudaStreamSynchronize(stream));
+  uniform_vector_check(device_values, F::inverse(value), count, count, S{});
+  const S points[] = {S{}, F::get_one(), field(0x9e3779b9u)};
+  for (const auto &point : points) {
+    for (unsigned alias_mode = 0; alias_mode < 3; ++alias_mode) {
+      CHECK(ff::set_value_one<F>(device_values, count, stream));
+      CHECK(cudaMemcpyAsync(device_point, &point, sizeof(S), cudaMemcpyHostToDevice, stream));
+      S *result = alias_mode == 1 ? device_values + count - 1 : alias_mode == 2 ? device_point : device_output;
+      CHECK(ff::poly_evaluate({pool, stream, device_values, device_point, result, count}));
+      CHECK(cudaStreamSynchronize(stream));
+      S actual;
+      CHECK(cudaMemcpy(&actual, result, sizeof(S), cudaMemcpyDeviceToHost));
+      const S expected = geometric_reference(point, count);
+      equal(actual, expected, "full25 polynomial", count, alias_mode);
+      uniform_vector_check(device_values, F::get_one(), count, alias_mode == 1 ? count - 1 : count, expected);
+    }
+  }
+  size_t scan_bytes = 0;
+  size_t sum_bytes = 0;
+  CHECK(ff::inclusive_prefix_product(nullptr, scan_bytes, device_values, device_values, CHUNK, stream));
+  CHECK(ff::sum(nullptr, sum_bytes, device_values, device_output, CHUNK, stream));
+  unsigned long long used_high = 0;
+  CHECK(cudaMemPoolGetAttribute(pool, cudaMemPoolAttrUsedMemHigh, &used_high));
+  // Explicit vector16MiB +4scalars; peak also includes bounded CUB scratch.
+  // Allow allocator granularity; this is a measured guard, not a GPU-fit proof.
+  const size_t bound = size_t(CHUNK) * sizeof(S) + scan_bytes + sum_bytes + 128 + (2u << 20);
+  if (used_high > bound) {
+    std::fprintf(stderr, "scratch bound failed used=%llu bound=%zu\n", used_high, bound);
+    std::exit(3);
+  }
+  std::printf("CPU-reference/CUDA full25 PASS scratch_high=%llu bound=%zu scan=%zu sum=%zu\n", used_high, bound, scan_bytes, sum_bytes);
+  CHECK(cudaFree(device_point));
+  CHECK(cudaFree(device_output));
+  CHECK(cudaFree(device_values));
+}
+
+int main(int argc, char **argv) {
+  CHECK(cudaSetDevice(0));
+  cudaMemPoolProps properties{};
+  properties.allocType = cudaMemAllocationTypePinned;
+  properties.handleTypes = cudaMemHandleTypeNone;
+  properties.location.type = cudaMemLocationTypeDevice;
+  properties.location.id = 0;
+  cudaMemPool_t pool;
+  cudaStream_t stream;
+  CHECK(cudaMemPoolCreate(&pool, &properties));
+  CHECK(cudaStreamCreate(&stream));
+  const unsigned counts[] = {0, 1, 2, 31, CHUNK - 1, CHUNK, CHUNK + 1, 2 * CHUNK + 37};
+  const S points[] = {S{}, F::get_one(), field(0x9e3779b9u)};
+  for (unsigned count : counts) {
+    inverse_test(pool, stream, count, false);
+    inverse_test(pool, stream, count, true);
+    for (const auto &point : points)
+      for (unsigned alias_mode = 0; alias_mode < 10; ++alias_mode)
+        polynomial_test(pool, stream, count, point, alias_mode);
+    std::printf("CPU-reference/CUDA correctness PASS count=%u\n", count);
+  }
+  inverse_zero_rejected(pool, stream, 1, 0);
+  inverse_zero_rejected(pool, stream, CHUNK + 1, 0);
+  inverse_zero_rejected(pool, stream, CHUNK + 1, CHUNK);
+  inverse_zero_rejected(pool, stream, 2 * CHUNK + 37, CHUNK + 3);
+  if (argc == 2 && std::string(argv[1]) == "--full25")
+    full25_test(pool, stream);
+  unsigned long long used_high = 0;
+  CHECK(cudaMemPoolGetAttribute(pool, cudaMemPoolAttrUsedMemHigh, &used_high));
+  std::printf("FF scratch pool observed high bytes=%llu\n", used_high);
+  CHECK(cudaStreamDestroy(stream));
+  CHECK(cudaMemPoolDestroy(pool));
+  return 0;
+}
