+#!/usr/bin/env python3
+"""CPU mathematical/model tests only; never assert CUDA execution or GPU-fit green."""
+import hashlib
+from pathlib import Path
+import re
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+P = 21888242871839275222246405745257275088548364400416034343698204186575808495617
+SOURCE_PINS = {
+    "src/ff.cu": "13e022d0078c9c49496c8808729c27b463216421006653172658058a485b8c29",
+    "src/ff_kernels.cu": "4ec81224687ec11bb58026697abb9a5523c5c64a4e4b5a7f0a7a2a32f6ab5843",
+    "src/ff_kernels.cuh": "2fd3d6c9bd9dd7c9211e8db5368bf9db76ae303b00c69dc38071f4693a4d9ffb",
+}
+SOURCE = (ROOT / "src/ff.cu").read_text()
+CHUNK = 1 << int(re.search(r"FF_SCRATCH_CHUNK_COUNT = 1u << (\d+)", SOURCE).group(1))
+
+
+def chunks(count):
+    offset = 0
+    while offset < count:
+        length = min(count - offset, CHUNK)
+        yield offset, length
+        offset += length
+
+
+def scalar_power(base, exponent):
+    value = 1
+    while exponent:
+        if exponent & 1:
+            value = value * base % P
+        base = base * base % P
+        exponent >>= 1
+    return value
+
+
+def polynomial(coefficients, point):
+    # Snapshot the point and delay the only externally visible result write.
+    point = int(point)
+    result = 0
+    for offset, count in chunks(len(coefficients)):
+        local_sum, power = 0, 1
+        for value in coefficients[offset:offset + count]:
+            local_sum = (local_sum + value * power) % P
+            power = power * point % P
+        result = (result + local_sum * scalar_power(point, offset)) % P
+    return result
+
+
+def horner(coefficients, point):
+    result = 0
+    for value in reversed(coefficients):
+        result = (result * point + value) % P
+    return result
+
+
+def inverse_alias(values):
+    if any(value == 0 for value in values):
+        raise ValueError("invalid zero denominator")
+    for offset, count in chunks(len(values)):
+        prefix = []
+        product = 1
+        for value in values[offset:offset + count]:
+            prefix.append(product)
+            product = product * value % P
+        inverse = pow(product, P - 2, P)
+        for local in range(count - 1, -1, -1):
+            index = offset + local
+            old = values[index]
+            values[index] = prefix[local] * inverse % P
+            inverse = inverse * old % P
+
+
+class ReferenceTests(unittest.TestCase):
+    def test_source_pins_and_allocation_geometry(self):
+        for name, expected in SOURCE_PINS.items():
+            self.assertEqual(hashlib.sha256((ROOT / name).read_bytes()).hexdigest(), expected)
+        self.assertEqual(CHUNK * 32, 16 * 1024**2)
+        for count in (0, 1, CHUNK - 1, CHUNK, CHUNK + 1, 1 << 25, (1 << 32) - 1):
+            schedule = list(chunks(count))
+            self.assertEqual(sum(length for _, length in schedule), count)
+            self.assertTrue(all(0 < length <= CHUNK for _, length in schedule))
+        self.assertEqual(len(list(chunks(1 << 25))), 64)
+
+    def test_scalar_power_zero_one_random_absolute_offsets(self):
+        for point in (0, 1, 0x9E3779B9, P - 1):
+            for exponent in (0, 1, 31, CHUNK - 1, CHUNK, CHUNK + 1, (1 << 25) - 1):
+                self.assertEqual(scalar_power(point, exponent), pow(point, exponent, P))
+
+    def test_polynomial_horner_boundaries_and_exact_aliases(self):
+        for count in (0, 1, 31, CHUNK - 1, CHUNK, CHUNK + 1, 2 * CHUNK + 37):
+            original = [0 if index % 17 == 0 else (index * 1664525 + 1013904223) % P for index in range(count)]
+            for point in (0, 1, 0x9E3779B9):
+                expected = horner(original, point)
+                self.assertEqual(polynomial(original, point), expected)
+                for index in ({0, count // 2, count - 1} if count else set()):
+                    aliased = original.copy()
+                    result = polynomial(aliased, point)
+                    aliased[index] = result
+                    self.assertEqual(aliased[index], expected)
+                    self.assertEqual(aliased[:index], original[:index])
+                    self.assertEqual(aliased[index + 1:], original[index + 1:])
+                # Snapshot before the point itself becomes the result.
+                aliased_point = [point]
+                aliased_point[0] = polynomial(original, aliased_point[0])
+                self.assertEqual(aliased_point[0], expected)
+
+    def test_inverse_nonzero_boundaries_against_independent_scalar_oracle(self):
+        oracle = {value: pow(value, P - 2, P) for value in range(1, 258)}
+        for count in (0, 1, 31, CHUNK - 1, CHUNK, CHUNK + 1, 2 * CHUNK + 37):
+            original = [index % 257 + 1 for index in range(count)]
+            actual = original.copy()
+            inverse_alias(actual)
+            self.assertEqual(actual, [oracle[value] for value in original])
+
+    def test_zero_denominator_rejected_before_any_mutation(self):
+        for count, zero_index in ((1, 0), (CHUNK + 1, 0), (CHUNK + 1, CHUNK), (2 * CHUNK + 37, CHUNK + 3)):
+            values = [index % 257 + 1 for index in range(count)]
+            values[zero_index] = 0
+            before = values.copy()
+            with self.assertRaises(ValueError):
+                inverse_alias(values)
+            self.assertEqual(values, before)
+
