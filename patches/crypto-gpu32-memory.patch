+                .map(|coefficient| {
+                    let mut value = z.pow_u64(degree as u64);
+                    value.mul_assign(coefficient);
+                    value
+                })
+                .collect();
+            let mut evaluations_at_z = svec!(h_evaluations_at_z.len());
+            evaluations_at_z.copy_from_slice(&h_evaluations_at_z)?;
+            let mut h_evaluation_at_z_omega = z_omega.pow_u64(degree as u64);
+            h_evaluation_at_z_omega.mul_assign(&extension_coefficient);
+            let h_evaluations_at_z_omega = [h_evaluation_at_z_omega];
+            let mut evaluations_at_z_omega = svec!(1);
+            evaluations_at_z_omega.copy_from_slice(&h_evaluations_at_z_omega)?;
+            let mut evaluations_at_zero = svec!(2);
+            evaluations_at_zero.copy_from_slice(&[EF::ZERO; 2])?;
+            let evaluations_at_zero = Some(evaluations_at_zero);
+            let public_inputs: Vec<_> = [omega, omega.pow_u64(2)]
+                .into_iter()
+                .map(|point| (point, vec![(0, point.pow_u64(degree as u64))]))
+                .collect();
+
+            for coset_idx in 0..4 {
+                let mut shift = F::multiplicative_generator();
+                shift.mul_assign(
+                    &lde_omega.pow_u64(bitreverse_index(
+                        coset_idx,
+                        LDE_DEGREE.trailing_zeros() as usize,
+                    ) as u64),
+                );
+                let h_roots: Vec<_> = (0..DOMAIN_SIZE)
+                    .map(|index| {
+                        let mut point = omega.pow_u64(bitreverse_index(
+                            index,
+                            DOMAIN_SIZE.trailing_zeros() as usize,
+                        ) as u64);
+                        point.mul_assign(&shift);
+                        point
