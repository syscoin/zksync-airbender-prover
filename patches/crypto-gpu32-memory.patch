+                    .collect();
+                let h_values: Vec<_> = h_roots
+                    .iter()
+                    .map(|point| point.pow_u64(degree as u64))
+                    .collect();
+                let mut trace_storage = GenericTraceStorage::<CosetEvaluations>::new(
+                    dvec!(3 * DOMAIN_SIZE),
+                    TraceLayout {
+                        num_variable_cols: 1,
+                        num_witness_cols: 1,
